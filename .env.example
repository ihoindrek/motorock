# Copy to .env.local and fill in values.
# Never commit .env.local.

# --- Google Maps / Places ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server-side Places API for Google reviews (falls back to Maps key)
GOOGLE_PLACES_API_KEY=

# --- Storefront ---
NEXT_PUBLIC_STOREFRONT_URL=https://motorock.eu
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CONSENT_ENABLED=true
NEXT_PUBLIC_CHECKOUT_LIVE=false
SITE_INDEXING=true

# --- WooCommerce backend (headless) ---
WOOCOMMERCE_STORE_URL=https://shop.motorock.eu
WOOCOMMERCE_GRAPHQL_URL=https://shop.motorock.eu/graphql

# --- Cache / webhooks ---
REVALIDATE_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=

# --- Monitoring alerts ---
# Slack incoming webhook (primary channel)
SLACK_WEBHOOK_URL=
# Email alerts are off by default. Set only if you also want Resend emails:
# MONITORING_EMAIL_ALERTS=true
# MONITORING_ALERT_EMAIL=dev@motorock.eu
# MONITORING_ALERTS_ENABLED=false
# MONITORING_ALERT_SECRET=
# GitHub Actions health check (.github/workflows/health-check.yml) needs the same
# secret in repo Settings → Secrets: MONITORING_ALERT_SECRET, CRON_SECRET, or REVALIDATE_SECRET.
# Optional Sentry (in addition to email alerts)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Forms (Resend) ---
RESEND_API_KEY=
FORM_FROM_EMAIL=Motorock <info@motorock.eu>
FORM_DEFAULT_TO=info@motorock.eu
# FORM_BCC_EMAIL=dev@motorock.eu
# FORM_DRY_RUN=true

# --- Montonio ---
MONTONIO_ACCESS_KEY=
MONTONIO_SECRET_KEY=
# MONTONIO_SANDBOX=true

# --- AI Engine (feature/ai-engine) ---
# Protects POST /api/ai/generate and POST /api/ai/batch
AI_API_SECRET=
# Same value in wp-config.php as MOTOROCK_AI_API_SECRET (Woo admin button)
# MOTOROCK_AI_API_SECRET=
# Shared secret for WordPress write endpoint (motorock/v1/ai/write)
MOTOROCK_AI_WRITE_SECRET=

# Provider: anthropic (recommended) | openai | gemini
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# AI_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional OpenAI fallback
# OPENAI_API_KEY=
# AI_OPENAI_MODEL=gpt-4.1-mini

# Optional Google Gemini
# GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# AI_GEMINI_MODEL=gemini-2.0-flash

# AI_DRY_RUN=true
# AI_DEFAULT_OVERWRITE=if_empty
